          "format": "date-time",
          "description": "Data de cadastro do imóvel"
        },
        "atualizadoEm": {
          "type": "string",
          "format": "date-time",
          "description": "Data da última alteração"
        }
      },
      "required": ["titulo", "tipo", "preco", "status", "corretorId", "criadoEm", "atualizadoEm"]
    },
