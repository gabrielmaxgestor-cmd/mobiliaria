      "title": "Usuários",
      "description": "Perfis de usuários cadastrados no Living Canvas (clientes e corretores)",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "ID do usuário no Firebase Auth"
        },
        "nome": {
          "type": "string",
          "description": "Nome completo do usuário"
        },
        "email": {
          "type": "string",
          "description": "E-mail do usuário"
        },
        "role": {
          "type": "string",
          "enum": ["cliente", "corretor"],
          "description": "Papel do usuário no sistema"
        },
        "telefone": {
          "type": "string",
          "description": "Telefone / WhatsApp de contato"
        },
        "avatarUrl": {
          "type": "string",
          "description": "URL da foto de perfil no Storage"
        },
        "preferenciasNotif": {
          "type": "object",
          "description": "Preferências de recebimento de notificações"
        },
        "compartilharPreferencias": {
          "type": "boolean",
          "description": "Consentimento para corretores lerem favoritos e buscas desejadas"
        },
        "criadoEm": {
          "type": "string",
          "format": "date-time",
          "description": "Data e hora de criação do perfil"
        }
      },
      "required": ["uid", "nome", "email", "role", "criadoEm"]
    },
